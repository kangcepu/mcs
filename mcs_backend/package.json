{
  "name": "mcs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express/TypeScript replacement API for MCS",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test:smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.4",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.15",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
